<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Runs AppContextInitializer from a ContentProvider before Application.onCreate,
             so the module can reach a Context without the app module wiring anything up. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.qiaoyuang.movie.model.AppContextInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
